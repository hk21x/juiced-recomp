# This game's values for the shared scripts in sdk/scripts (sdk/scripts/common.sh lists each and its default)
GAME_XBE=default.xbe
GAME_LOG=juiced           # GameInfo::log
GAME_TARGET=Juiced        # the add_xbe_image target in CMakeLists.txt
GHIDRA_PROJECT=juiced
SMOKE_PAD=scripts/pad/race.txt  # title, a profile, Arcade, Novice series, race 1, throttle
SMOKE_MENU=              # "first last" vertical blanks where a 2D menu is up before the pad's menu choice
SOAK_PAD=scripts/pad/soak.py   # Arcade race 1, random driving, the pause menu's Restart, again
